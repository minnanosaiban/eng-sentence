{
  "name": "eng-sentence",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-06",
  "assets": { "directory": "./public", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    // database_id は、`npx wrangler d1 create eng-sentence-db` で作ったあとに、表示された ID に書き換える
    { "binding": "DB", "database_name": "eng-sentence-db", "database_id": "891cde40-4284-47cb-9e38-347ee4e734f6", "migrations_dir": "migrations" }
  ],
  // 作成できる保管庫の数。持ち主が作成した後は他人が作れないよう 1 にしている
  "vars": { "MAX_VAULTS": "1" }
}
